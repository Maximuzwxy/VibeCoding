}
body.light{background:#f0f0f0;color:#222;}
#container{position:relative;width:960px;height:540px;}
canvas{display:block;border-radius:8px;box-shadow:0 4px 30px rgba(0,0,0,.5);}

#settingsBtn{
  position:absolute;top:10px;right:10px;
  font-size:24px;background:none;border:none;color:#ff6b6b;
  cursor:pointer;z-index:20;display:none;
}
#settingsBtn:hover{color:#e55a5a;}

#hud{
  position:absolute;top:10px;left:50%;transform:translateX(-50%);
  display:none;gap:20px;font-size:18px;font-weight:bold;
}
#hud .timer{color:#ff6b6b;}
#hud .tagger-label{padding:4px 12px;border-radius:20px;font-size:14px;}

#menu{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  text-align:center;z-index:10;
}
#menu h1{font-size:48px;margin-bottom:10px;letter-spacing:4px;text-shadow:0 0 20px rgba(255,100,100,.5);}
#menu .sub{font-size:16px;opacity:.7;margin-bottom:30px;}
.menu-panel{
  background:rgba(0,0,0,.75);border-radius:16px;padding:30px 40px;
  min-width:380px;backdrop-filter:blur(10px);
  transition:background .4s;
}
body.light .menu-panel{background:rgba(255,255,255,.85);}
.menu-panel h3{font-size:20px;margin-bottom:20px;color:#ff6b6b;}
.btn{
  display:inline-block;padding:12px 28px;margin:6px;font-size:16px;
  border:2px solid #ff6b6b;background:transparent;color:#ff6b6b;
  border-radius:8px;cursor:pointer;transition:all .2s;
  font-weight:bold;letter-spacing:1px;
}
.btn:hover{background:#ff6b6b;color:#fff;}
.btn.primary{background:#ff6b6b;color:#fff;padding:14px 40px;font-size:18px;}
.btn.primary:hover{background:#e55a5a;border-color:#e55a5a;}
.btn.back{border-color:#aaa;color:#aaa;}
.btn.back:hover{background:#aaa;color:#fff;}

.settings-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;}
.settings-row span{font-size:15px;}
.toggle{position:relative;width:50px;height:26px;display:inline-block;}
.toggle input{opacity:0;width:0;height:0;}
.toggle .slider{
  position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;
  background:#555;border-radius:26px;transition:.3s;
}
.toggle .slider:before{
  content:'';position:absolute;height:20px;width:20px;
  left:3px;bottom:3px;background:white;border-radius:50%;transition:.3s;
}
.toggle input:checked+.slider{background:#ff6b6b;}
.toggle input:checked+.slider:before{transform:translateX(24px);}

#countdown{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  font-size:80px;font-weight:bold;color:#ff6b6b;display:none;z-index:15;
  text-shadow:0 0 40px rgba(255,100,100,.7);
}

.hidden{display:none !important;}
</style>
</head>
<body id="bodyEl">
<div id="container">
<canvas id="gameCanvas" width="960" height="540"></canvas>
<button id="settingsBtn" onclick="openSettings()">&#9881;</button>

