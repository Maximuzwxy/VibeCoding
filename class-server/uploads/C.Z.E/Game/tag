// ==================== PLAYER CLASS ====================
function Player(id, x, y, color, name){
  this.id = id;
  this.x = x;
  this.y = y;
  this.w = 28;
  this.h = 38;
  this.vx = 0;
  this.vy = 0;
  this.color = color;
  this.name = name;
  this.isTagger = false;
  this.cooldown = 0;
  this.onGround = false;
  this.facingRight = true;
}

function getPlayerColors(){
  if(threePlayerMode) return ['#e74c3c','#3498db','#2ecc71'];
  return ['#e74c3c','#3498db'];
}

function getPlayerNames(){
  if(threePlayerMode) return ['P1','P2','P3'];
  if(aiMode) return ['You','AI'];
  return ['P1','P2'];
}

// ==================== MAP RENDERING ====================
function drawMapBackground(){
  var t = mapTheme;
  var grad = ctx.createLinearGradient(0,0,0,H);
  grad.addColorStop(0, t.bgTop);
  grad.addColorStop(1, t.bgBot);
  ctx.fillStyle = grad;
  ctx.fillRect(0,0,W,H);

  // Map-specific decorations
  if(selectedMap === 0){
    // Forest - trees
    ctx.fillStyle = '#1a5c1a';
    [50,200,400,600,800].forEach(function(x){
      ctx.fillRect(x-8,420,16,80);
      ctx.beginPath(); ctx.arc(x,400,30,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(x-15,420,25,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(x+15,420,25,0,Math.PI*2); ctx.fill();
    });
  } else if(selectedMap === 1){
    // Desert - dunes
    ctx.fillStyle = '#c4956a';
    [0,300,600].forEach(function(x){
      ctx.beginPath(); ctx.arc(x+100,510,80,Math.PI,0); ctx.fill();
    });
  } else if(selectedMap === 2){
    // City - windows
    ctx.fillStyle = '#f1c40f';
    [60,120,200,280,360,440,520,600,680,760,840].forEach(function(x){
      if((x>200&&x<400)||(x>550&&x<700)) return;
      ctx.fillRect(x+5,440,10,12);
      ctx.fillRect(x+20,440,10,12);
    });
  } else if(selectedMap === 3){
    // Ice - crystals
    ctx.fillStyle = 'rgba(100,200,255,0.3)';
    [100,350,600,850].forEach(function(x){
      ctx.beginPath(); ctx.moveTo(x,400); ctx.lineTo(x+20,360); ctx.lineTo(x+40,400); ctx.fill();
    });
  } else if(selectedMap === 4){
    // Space - stars
    ctx.fillStyle = 'white';
    var i, sx, sy;
    for(i=0;i<60;i++){
      sx = Math.random()*W;
      sy = Math.random()*H*0.7;
      ctx.globalAlpha = 0.3 + Math.random()*0.7;
      ctx.fillRect(sx,sy,2,2);
    }
    ctx.globalAlpha = 1;
  }

  // Draw platforms
  var p, pg;
  for(var i=0;i<platforms.length;i++){
    p = platforms[i];
    pg = ctx.createLinearGradient(p.x, p.y, p.x, p.y+p.h);
    pg.addColorStop(0, t.platTop||'#8B7355');
    pg.addColorStop(1, t.platBot||'#6B5340');
    ctx.fillStyle = pg;
    ctx.fillRect(p.x, p.y, p.w, p.h);
    ctx.strokeStyle = t.platStroke||'rgba(0,0,0,0.3)';
    ctx.lineWidth = 2;
    ctx.strokeRect(p.x, p.y, p.w, p.h);
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.fillRect(p.x, p.y, p.w, 3);
  }
}

function drawPlayer(p){
  ctx.save();
  if(p.cooldown > 0){
    ctx.globalAlpha = 0.5 + Math.sin(Date.now()/100)*0.2;
  }

  var px = p.x + p.w/2;
  var py = p.y + p.h/2;

  // Body
  ctx.fillStyle = p.color;
  ctx.fillRect(p.x, p.y+8, p.w, p.h-8);
  // Head
  ctx.beginPath(); ctx.arc(px, p.y+8, 12, 0, Math.PI*2); ctx.fill();
  // Eyes
  ctx.fillStyle = 'white';
  ctx.beginPath(); ctx.arc(px-4, p.y+5, 4, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(px+4, p.y+5, 4, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = '#222';
  var eyeDir = p.facingRight ? 1.5 : -1.5;
  ctx.beginPath(); ctx.arc(px-4+eyeDir, p.y+5, 2, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(px+4+eyeDir, p.y+5, 2, 0, Math.PI*2); ctx.fill();

  // Tagger ring at feet
  if(p.isTagger){
    ctx.strokeStyle = p.color;
    ctx.lineWidth = 3;
    ctx.globalAlpha = 0.6 + Math.sin(Date.now()/150)*0.4;
    ctx.beginPath();
    ctx.ellipse(px, py+p.h/2, 16, 6, 0, 0, Math.PI*2);
    ctx.stroke();
    ctx.lineWidth = 1.5;
    ctx.globalAlpha = 0.3 + Math.sin(Date.now()/200+1)*0.3;
    ctx.beginPath();
    ctx.ellipse(px, py+p.h/2, 22, 8, 0, 0, Math.PI*2);
    ctx.stroke();
  }

  // Name label
  ctx.globalAlpha = 1;
  ctx.fillStyle = 'white';
  ctx.font = 'bold 11px sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText(p.name, px, py-20);
  if(p.isTagger){
    ctx.fillStyle = '#ff6b6b';
    ctx.font = 'bold 10px sans-serif';
    ctx.fillText('IT!', px, py-32);
  }

  ctx.restore();
}

// ==================== PHYSICS & COLLISION ====================
function updatePlayer(p){
  p.vy += GRAVITY;
  p.x += p.vx;
  p.y += p.vy;

  if(p.x < 0){ p.x = 0; p.vx = 0; }
  if(p.x + p.w > W){ p.x = W - p.w; p.vx = 0; }

  if(p.cooldown > 0) p.cooldown -= 1/60;

  p.onGround = false;
  var pl;
  for(var i=0;i<platforms.length;i++){
    pl = platforms[i];
    if(p.x+p.w > pl.x && p.x < pl.x+pl.w){
      if(p.vy >= 0 && p.y+p.h >= pl.y && p.y+p.h <= pl.y+pl.h+15){
        p.y = pl.y - p.h;
        p.vy = 0;
        p.onGround = true;
      }
      if(p.vy < 0 && p.y <= pl.y+pl.h && p.y >= pl.y){
        p.y = pl.y + pl.h;
        p.vy = 0;
      }
    }
  }

  if(p.y + p.h > H){ p.y = H - p.h; p.vy = 0; p.onGround = true; }

  if(p.onGround) p.vx *= FRICTION; else p.vx *= 0.95;
  if(Math.abs(p.vx) < 0.1) p.vx = 0;

  if(p.vx > 0.1) p.facingRight = true;
  if(p.vx < -0.1) p.facingRight = false;
}

function checkTag(){
  var tagger = null;
  for(var i=0;i<players.length;i++){
    if(players[i].isTagger){ tagger = players[i]; break; }
  }
  if(!tagger) return;

  var p;
  for(var i=0;i<players.length;i++){
    p = players[i];
    if(p === tagger || p.cooldown > 0) continue;
    if(p.x < tagger.x+tagger.w && p.x+p.w > tagger.x &&
       p.y < tagger.y+tagger.h && p.y+p.h > tagger.y){
      tagger.isTagger = false;
      p.isTagger = true;
      p.cooldown = 2;
      playTagSound();
      break;
    }
  }
}

// ==================== AI ====================
function aiControl(aiPlayer){
  var tagger = null;
  for(var i=0;i<players.length;i++){
    if(players[i].isTagger){ tagger = players[i]; break; }
  }
  var speed = 3.5;

  if(aiPlayer.isTagger){
    var target = null, minDist = Infinity;
    var p, d;
    for(var i=0;i<players.length;i++){
      p = players[i];
      if(p === aiPlayer || p.cooldown > 0) continue;
      d = Math.abs(p.x - aiPlayer.x) + Math.abs(p.y - aiPlayer.y);
      if(d < minDist){ minDist = d; target = p; }
    }
    if(target){
      if(target.x < aiPlayer.x - 10) aiPlayer.vx = -speed;
      else if(target.x > aiPlayer.x + 10) aiPlayer.vx = speed;
      if(target.y < aiPlayer.y - 40 && aiPlayer.onGround) aiPlayer.vy = -11;
    }
  } else {
    if(tagger){
      if(tagger.x < aiPlayer.x) aiPlayer.vx = speed;
      else aiPlayer.vx = -speed;
      if(tagger.y < aiPlayer.y - 30 && aiPlayer.onGround) aiPlayer.vy = -11;
      if(Math.abs(tagger.x - aiPlayer.x) < 50 && aiPlayer.onGround && Math.random() < 0.1) aiPlayer.vy = -10;
    }
  }
  if(aiPlayer.onGround && Math.random() < 0.02) aiPlayer.vy = -10;
}

// ==================== GAME LOOP ====================
function gameLoop(){
  ctx.clearRect(0,0,W,H);
  if(gameState === 'playing' || gameState === 'countdown'){
    drawMapBackground();
    var i;
    for(i=0;i<players.length;i++){
      if(aiMode && players[i].id === 1) aiControl(players[i]);
      updatePlayer(players[i]);
    }
    if(gameState === 'playing') checkTag();
    for(i=0;i<players.length;i++) drawPlayer(players[i]);

    // Cooldown indicator
    for(i=0;i<players.length;i++){
      if(players[i].cooldown > 0){
        ctx.fillStyle = 'rgba(0,0,0,0.4)';
        ctx.font = 'bold 13px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(Math.ceil(players[i].cooldown)+'s', players[i].x+players[i].w/2, players[i].y-45);
      }
    }
  }
  requestAnimationFrame(gameLoop);
}

// ==================== INPUT ====================
document.addEventListener('keydown', function(e){
  keys[e.key.toLowerCase()] = true;
  e.preventDefault();
});
document.addEventListener('keyup', function(e){
  keys[e.key.toLowerCase()] = false;
  e.preventDefault();
});

function handleInput(){
  if(gameState !== 'playing') return;
  var speed = 5, jumpVel = -12;

  // Player 1: W/A/D
  var p1 = players[0];
  if(p1){
    if(keys['a']) p1.vx = -speed;
    if(keys['d']) p1.vx = speed;
    if(keys['w'] && p1.onGround) p1.vy = jumpVel;
  }

  if(!aiMode){
    if(threePlayerMode){
      // P2: Y/G/J
      var p2 = players[1];
      if(p2){
        if(keys['g']) p2.vx = -speed;
        if(keys['j']) p2.vx = speed;
        if(keys['y'] && p2.onGround) p2.vy = jumpVel;
      }
      // P3: Arrow keys
      var p3 = players[2];
      if(p3){
        if(keys['arrowleft']) p3.vx = -speed;
        if(keys['arrowright']) p3.vx = speed;
        if(keys['arrowup'] && p3.onGround) p3.vy = jumpVel;
      }
    } else {
      // Two-player: P2 uses arrow keys
      var p2b = players[1];
      if(p2b){
        if(keys['arrowleft']) p2b.vx = -speed;
        if(keys['arrowright']) p2b.vx = speed;
        if(keys['arrowup'] && p2b.onGround) p2b.vy = jumpVel;
      }
    }
  }
}
setInterval(handleInput, 16);

// ==================== GAME FLOW ====================
function showModeSelect(){
  document.getElementById('menuMain').classList.add('hidden');
  document.getElementById('menuMode').classList.remove('hidden');
}

function selectMode(count, mode){
  playerCount = count;
  aiMode = (mode === 'ai');
  threePlayerMode = (count === 3);
  document.getElementById('menuMode').classList.add('hidden');
  var mapDiv = document.getElementById('mapButtons');
  var html = '';
  for(var i=0;i<maps.length;i++){
    html += '<button class="btn" onclick="selectMap('+i+')">'+maps[i].name+'</button>';
  }
  mapDiv.innerHTML = html;
  document.getElementById('menuMap').classList.remove('hidden');
}

function selectMap(index){
  selectedMap = index;
  document.getElementById('menuMap').classList.add('hidden');
  document.getElementById('menuTime').classList.remove('hidden');
}

function backToMain(){
  stopGame();
  var divs = document.getElementById('menu').children;
  for(var i=0;i<divs.length;i++) divs[i].classList.add('hidden');
  document.getElementById('menuMain').classList.remove('hidden');
  document.getElementById('gameOver').classList.add('hidden');
  document.getElementById('settingsBtn').style.display = 'none';
  document.getElementById('hud').style.display = 'none';
}

function backToMode(){
  document.getElementById('menuMap').classList.add('hidden');
  document.getElementById('menuMode').classList.remove('hidden');
}

function backToMap(){
  document.getElementById('menuTime').classList.add('hidden');
  document.getElementById('menuMap').classList.remove('hidden');
}

function showSettings(){
  document.getElementById('menuMain').classList.add('hidden');
  document.getElementById('menuSettings').classList.remove('hidden');
}

function closeSettings(){
  document.getElementById('menuSettings').classList.add('hidden');
  document.getElementById('menuMain').classList.remove('hidden');
}

function openSettings(){
  if(gameState === 'playing') stopGame();
  var divs = document.getElementById('menu').children;
  for(var i=0;i<divs.length;i++) divs[i].classList.add('hidden');
  document.getElementById('gameOver').classList.add('hidden');
  document.getElementById('settingsBtn').style.display = 'none';
  document.getElementById('hud').style.display = 'none';
  document.getElementById('menuSettings').classList.remove('hidden');
}

function startGame(time){
  initAudio();
  if(musicOn) startMusic();
  document.getElementById('menuTime').classList.add('hidden');
  document.getElementById('settingsBtn').style.display = 'block';
  document.getElementById('hud').style.display = 'flex';

  gameTime = time;
  timeLeft = time;
  mapTheme = maps[selectedMap];
  platforms = maps[selectedMap].platforms;
  var colors = getPlayerColors();
  var names = getPlayerNames();
  var starts = maps[selectedMap].playerStart;

  players = [];
  for(var i=0;i<playerCount;i++){
    var s = starts[i] || starts[0];
    players.push(new Player(i, s.x, s.y, colors[i], names[i]));
  }

  // Random tagger
  var taggerIdx = Math.floor(Math.random() * playerCount);
  players[taggerIdx].isTagger = true;

  // Countdown
  gameState = 'countdown';
  countdownValue = 3;
  document.getElementById('countdown').style.display = 'block';
  updateHUD();

  var cdInterval = setInterval(function(){
    countdownValue--;
    if(countdownValue > 0){
      document.getElementById('countdown').textContent = countdownValue;
      playCountdownBeep();
    } else {
      document.getElementById('countdown').textContent = 'GO!';
      playSfx(880, 'sine', 0.2, 0.15);
      setTimeout(function(){
        document.getElementById('countdown').style.display = 'none';
        gameState = 'playing';
        timerInterval = setInterval(function(){
          timeLeft--;
          updateHUD();
          if(timeLeft <= 0) endGame();
        }, 1000);
      }, 500);
      clearInterval(cdInterval);
    }
  }, 800);
}

function updateHUD(){
  document.getElementById('timerDisplay').textContent = 'Time: ' + timeLeft + 's';
  var tagger = null;
  for(var i=0;i<players.length;i++){
    if(players[i].isTagger){ tagger = players[i]; break; }
  }
  if(tagger){
    var lbl = document.getElementById('taggerLabel');
    lbl.textContent = tagger.name + ' is IT!';
    lbl.style.background = tagger.color;
    lbl.style.color = '#fff';
  }
}

function endGame(){
  gameState = 'over';
  clearInterval(timerInterval);
  stopMusic();
  playGameOverSound();

  var tagger = null;
  for(var i=0;i<players.length;i++){
    if(players[i].isTagger){ tagger = players[i]; break; }
  }
  var loserName = tagger ? tagger.name : 'Nobody';
  document.getElementById('gameOverTitle').textContent = "Time's Up!";
  document.getElementById('gameOverMsg').innerHTML =
    '<span style="color:'+(tagger?tagger.color:'#fff')+'">'+loserName+'</span> was the tagger &mdash; <b>'+loserName+' loses!</b>';
  document.getElementById('gameOver').classList.remove('hidden');
  document.getElementById('settingsBtn').style.display = 'none';
  document.getElementById('hud').style.display = 'none';
}

function stopGame(){
  gameState = 'menu';
  clearInterval(timerInterval);
  stopMusic();
  players = [];
  countdownValue = 0;
  document.getElementById('countdown').style.display = 'none';
}

// ==================== INIT ====================
gameLoop();
</script>
</body>
